NODE_ENV=development
API_PORT=3000

POSTGRES_DB=accesos
POSTGRES_USER=accesos
POSTGRES_PASSWORD=replace_with_a_local_secret
POSTGRES_PORT=5432

# Dueño de las tablas: migraciones, alta de empresas y preparación del usuario de la API.
DATABASE_OWNER_URL=postgresql://accesos:replace_with_a_local_secret@localhost:5432/accesos?schema=public

# Usuario de la API, sujeto a Row Level Security. Lo crea `pnpm run db:prepare`.
DATABASE_URL=postgresql://accesos_api:replace_with_another_local_secret@localhost:5432/accesos?schema=public

# 32 bytes en base64 para cifrar los secretos de doble factor. Genera uno con:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOTP_ENCRYPTION_KEY=replace_with_32_random_bytes_in_base64

# Otros 32 bytes en base64, distintos, para cifrar plantillas faciales y fotos de checadas.
# Respáldala fuera del servidor: sin ella no se pueden leer los rostros guardados.
BIOMETRIC_ENCRYPTION_KEY=replace_with_other_32_random_bytes_in_base64

# HTTPS directo (opcional en desarrollo). Los genera deploy/generar-certificado.ps1.
# TLS_CERT_FILE=deploy/certs/servidor.crt
# TLS_KEY_FILE=deploy/certs/servidor.key

# Solo para `docker compose --profile servidor`: misma contraseña que DATABASE_URL.
API_DB_PASSWORD=replace_with_another_local_secret
# API_PUBLIC_PORT=443
